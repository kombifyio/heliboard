<helium314.keyboard.latin.InputView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/fakeToast"
        layout="@layout/fake_toast" />

    <!-- SpeechKit: pin the keyboard to the bottom. In non-fullscreen mode
         LatinIME stretches this input view to MATCH_PARENT, so a child with
         no layout_gravity lands at the top of the screen. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom">
        <include
            android:id="@+id/main_keyboard_frame"
            layout="@layout/main_keyboard_frame" />

        <!-- Dictation / voice-agent panel overlays the keys. The frame stays
             INVISIBLE rather than GONE so LatinIME's height math still holds. -->
        <FrameLayout
            android:id="@+id/speechkit_voice_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:visibility="gone" />
    </FrameLayout>
</helium314.keyboard.latin.InputView>

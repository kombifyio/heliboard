<helium314.keyboard.latin.InputView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/fakeToast"
        layout="@layout/fake_toast" />
    <include
        android:id="@+id/main_keyboard_frame"
        layout="@layout/main_keyboard_frame" />

    <!-- SpeechKit: the dictation panel is mounted here instead of replacing
         the whole input view. LatinIME sizes the window and computes the
         touchable region from its own keyboard frame, so swapping that frame
         out from under it produced a full-screen window whose upper half was
         rendered but dead to touch. Overlaying inside it keeps every one of
         those calculations valid, and the frame below stays INVISIBLE rather
         than GONE so it still contributes its height. -->
    <FrameLayout
        android:id="@+id/speechkit_voice_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</helium314.keyboard.latin.InputView>
